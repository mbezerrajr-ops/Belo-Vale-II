# Optional. `npm run dev` already proxies /api to http://localhost:8000
# (see vite.config.ts), and the Docker-built app talks to /api through
# nginx's own reverse proxy (see infra/nginx.web.conf) — so this is normally
# left unset. Only set it if you need the dev server to call an API that
# isn't on localhost:8000 (e.g. a remote/staging backend).
# VITE_API_BASE_URL=http://localhost:8000
