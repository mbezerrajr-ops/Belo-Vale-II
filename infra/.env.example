# Copy this file to `.env` (or a named file passed via `docker compose --env-file`,
# e.g. `.env.e2e` for local E2E runs) and fill in real values. Never commit the
# filled-in file — .gitignore already excludes `.env` and `.env.*` except this one.
#
# All of these are consumed by `docker compose -f infra/docker-compose.yml`.

# --- Required for every environment ---

# Postgres superuser-equivalent password for the `ingestion` role created by
# the official postgres image on first boot.
POSTGRES_PASSWORD=

# Full SQLAlchemy async URL the api/worker containers use to reach Postgres.
# Must use the `postgres` service's Docker network hostname ("db"), not
# localhost, and must embed the same password as POSTGRES_PASSWORD above.
# Example: postgresql+asyncpg://ingestion:<POSTGRES_PASSWORD>@db:5432/ingestion
POSTGRES_URL=

# MinIO (S3-compatible object storage) root credentials.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# HMAC signing secret for bearer access tokens. Required only for the `api`
# service (RUNTIME_ROLE=api); the worker never receives it. Must be at least
# 32 bytes.
AUTH_SECRET=

# --- Optional ---

# Postgres role name. Defaults to "ingestion" if unset.
POSTGRES_USER=

# --- Só para o E2E (infra/.env.e2e) ---
# Nome de projeto próprio: o E2E não compartilha volumes com o ambiente local.
# COMPOSE_PROJECT_NAME=belo-vale-e2e

# --- Leitura pela API Gemini (o caminho de produção desde 16/10/2026)
#
# Sem PC com placa de vídeo, fotos e gravações são lidas pela API Gemini, na
# conta paga da fazenda (o Google não treina com o que recebe nessa conta).
# O endereço é fixo no código; só a chave vem daqui:
#
#   READER_PROVIDER=gemini
#   AUDIO_PROVIDER=gemini
#   READER_MODEL=gemini-3.5-flash-lite
#   AUDIO_MODEL=gemini-3.5-flash-lite
#   GEMINI_API_KEY=
#
# Os leitores locais abaixo (Ollama e whisper) continuam funcionando para
# quem tiver GPU.

# --- Leitor de fotos de folha (visão computacional, na própria infraestrutura)
#
# READER_PROVIDER=fake (padrão) inventa a leitura: serve ao CI e à
# demonstração, e é recusado em produção. Para ler de verdade:
#
#   READER_PROVIDER=ollama
#
# Onde o modelo roda é só um endereço — e só endereço privado é aceito
# (loopback, rede privada, nome de serviço interno ou o apelido do
# hospedeiro). Três formatos, sem mudar código:
#
#   Windows, modelo fora do Docker (a GPU AMD não passa para o contêiner):
#   READER_URL=http://host.docker.internal:11434
#
#   Servidor Linux, modelo como serviço ao lado dos outros:
#   READER_URL=http://ollama:11434
#
#   Servidor remoto ligado por VPN (a foto não trafega pela internet aberta):
#   READER_URL=http://10.8.0.5:11434
#
# READER_MODEL=qwen2.5vl:7b

# --- Transcritor da gravação de voz (whisper.cpp, na própria infraestrutura)
#
# AUDIO_PROVIDER=fake (padrão) devolve sempre a mesma frase: serve ao CI e à
# demonstração, e é recusado em produção. Para ouvir de verdade:
#
#   AUDIO_PROVIDER=whisper
#
# Mesmos três formatos do leitor de fotos. No Windows, o whisper-server roda
# fora do Docker (tarefa agendada "BeloVale-Whisper") na porta 8081:
#
#   AUDIO_URL=http://host.docker.internal:8081
#
# AUDIO_MODEL=ggml-large-v3-turbo-q5_0
