# Copy this file to `.env` (or a named file passed via `docker compose --env-file`,
# e.g. `.env.e2e` for local E2E runs) and fill in real values. Never commit the
# filled-in file — .gitignore already excludes `.env` and `.env.*` except this one.
#
# All of these are consumed by `docker compose -f infra/docker-compose.yml`.

# --- Required for every environment ---

# Postgres superuser-equivalent password for the `ingestion` role created by
# the official postgres image on first boot.
POSTGRES_PASSWORD=

# Full SQLAlchemy async URL the api/worker containers use to reach Postgres.
# Must use the `postgres` service's Docker network hostname ("db"), not
# localhost, and must embed the same password as POSTGRES_PASSWORD above.
# Example: postgresql+asyncpg://ingestion:<POSTGRES_PASSWORD>@db:5432/ingestion
POSTGRES_URL=

# MinIO (S3-compatible object storage) root credentials.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# HMAC signing secret for bearer access tokens. Required only for the `api`
# service (RUNTIME_ROLE=api); the worker never receives it. Must be at least
# 32 bytes.
AUTH_SECRET=

# --- Optional ---

# Postgres role name. Defaults to "ingestion" if unset.
POSTGRES_USER=

# --- Only for integration with a real vision/OCR provider ---
# The API/worker default to VISION_PROVIDER=fake (FakeVisionProvider), which
# needs none of the following and is what local development, backend tests,
# and the Playwright E2E suite all use. These three only matter if you
# explicitly set VISION_PROVIDER=http in the worker's environment to call a
# real external vision/OCR service — never commit real values here.
# VISION_PROVIDER=http
# VISION_API_URL=
# VISION_API_KEY=

# --- Só para o E2E (infra/.env.e2e) ---
# Nome de projeto próprio: o E2E não compartilha volumes com o ambiente local.
# COMPOSE_PROJECT_NAME=belo-vale-e2e
# Mostra a área "Fichas" com o OCR falso, para o teste do fluxo de foto.
# Recusado em produção.
# PHOTO_SHEETS_DEMO=true
