FROM python:3.13-slim AS dependencies

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --no-dev --locked

FROM dependencies AS runtime

COPY apps/api/app ./app
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini ./alembic.ini

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')"

CMD ["uv", "run", "--no-sync", "uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]

# This target is intentionally separate from runtime: it adds only the locked
# development dependency group and the test sources needed by pytest.
FROM dependencies AS test

RUN uv sync --locked --group dev

COPY apps/api/app ./app
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini ./alembic.ini
COPY apps/api/tests ./tests
COPY infra/docker-compose.yml ./infra/docker-compose.yml
COPY .gitignore ./.gitignore

CMD ["sh", "-c", "uv run --no-sync alembic upgrade head && uv run --no-sync pytest -q"]
