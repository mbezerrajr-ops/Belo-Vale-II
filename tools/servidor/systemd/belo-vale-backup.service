[Unit]
Description=Belo Vale II: backup diário cifrado (banco, fotos e gravações) para o Backblaze
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=belovale
WorkingDirectory=/home/belovale/Belo-Vale-II
ExecStart=/home/belovale/Belo-Vale-II/tools/servidor/backup.sh
