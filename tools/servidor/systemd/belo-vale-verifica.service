[Unit]
Description=Belo Vale II: prova que o último backup restaura (sem tocar na produção)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=belovale
WorkingDirectory=/home/belovale/Belo-Vale-II
ExecStart=/home/belovale/Belo-Vale-II/tools/servidor/verificar-backup.sh
